{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`cells/<identity>/attempts/<n>/attempt.json`.",
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "attempt_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "calls": {
      "description": "External calls this attempt made.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "description": "The result image, relative to the attempt, when the heal completed.",
      "type": [
        "string",
        "null"
      ]
    },
    "run": {
      "description": "The run directory, relative to the attempt.",
      "type": "string"
    },
    "status": {
      "description": "`ok`, `stopped` (a step was not applicable) or `failed`.",
      "type": "string"
    },
    "stopped_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "attempt_version",
    "attempt",
    "status",
    "run",
    "calls"
  ],
  "title": "AttemptRecord",
  "type": "object"
}
