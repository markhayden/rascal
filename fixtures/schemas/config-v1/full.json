{
  "config_version": 1,
  "workspace": {
    "dir": "ws"
  },
  "corpus": {
    "manifest": "corpus.toml"
  },
  "fillers": {
    "hosted": {
      "url": "https://example.invalid/inpaint",
      "profile": "binary",
      "paste": "hard",
      "timeout_s": 180,
      "send_mask": false,
      "key_env": "HOSTED_FILLER_KEY",
      "max_side": 2048,
      "revision": "vendor model 2026-10",
      "spend_usd_per_call": 0.04
    },
    "local-inpaint": {
      "command": [
        "python",
        "fill.py",
        "{image}",
        "{mask}",
        "{out}"
      ],
      "profile": "grey",
      "paste": "feather",
      "timeout_s": 120,
      "send_mask": false,
      "revision": "fill.py 2026-10-28",
      "overrides": {
        "fan.constants": "fan-thin-v1",
        "fan.wide_max": 0.05
      },
      "fill_max_side": 1024
    }
  },
  "packs": {
    "rascal-tools": {
      "command": [
        "/opt/rascal-tools/.venv/bin/rascal-tools",
        "serve"
      ],
      "env": [
        "RASCAL_TOOLS_MODELS"
      ],
      "accepts": "path",
      "concurrent": false,
      "revision": "segmenter export 2026-10",
      "startup_timeout_s": 60,
      "call_timeout_s": 120
    }
  },
  "cache": {
    "dir": ".rascal/fills"
  },
  "limits": {
    "call_cap_usd": 0.5,
    "session_budget_usd": 5.0
  }
}
