  "notes": [
    "pack manifest: {\"pack\":\"fake\",\"revision\":\"fake 1\",\"manifest\":{\"manifest_version\":1,\"name\":\"segment\",\"version\":\"0.1.0\",\"purpose\":\"Finds the instances a prompt names in an image and returns a polygon and a plane for each.\",\"when_to_use\":\"When the region to mask is an object named in words rather than drawn.\",\"when_not_to_use\":\"When the region is a known box or a drawn stroke; use rect or stroke.\",\"output_guidance\":\"One region per instance with its score, and one plane image per region in the image's frame; select or rasterize makes a mask.\",\"cost\":{\"tier\":\"expensive\",\"seconds\":2.0},\"returns\":{\"max_images\":8,\"max_long_edge\":8192,\"max_image_bytes\":16777216,\"max_summary_bytes\":1024,\"max_regions\":8,\"max_region_label_bytes\":256,\"max_measurements\":8,\"max_transforms\":0,\"max_envelope_bytes\":1048576},\"model_schema\":{\"properties\":{\"prompt\":{\"type\":\"string\"}},\"type\":\"object\"},\"input_schema\":{\"type\":\"object\"},\"output_schema\":{\"type\":\"object\"},\"concurrent\":false,\"accepts_hints\":[],\"evidence_kind\":null,\"frame_args\":[],\"frames_out\":[],\"image_args\":[],\"pairs_with\":[],\"preconditions\":\"\",\"requires\":[]},\"rascal\":{\"annotation_version\":1,\"inputs\":[{\"name\":\"image\",\"artifact_type\":\"Image\",\"required\":true,\"purpose\":\"The image to segment.\"}],\"outputs\":[{\"name\":\"region\",\"artifact_type\":\"Location\",\"required\":true,\"purpose\":\"One polygon per instance, with its score.\",\"many\":true},{\"name\":\"plane\",\"artifact_type\":\"Image\",\"required\":true,\"purpose\":\"One instance plane per region, in the image's frame.\",\"many\":true}],\"params\":[{\"name\":\"prompt\",\"purpose\":\"What to find, in words.\",\"kind\":\"string\",\"required\":false,\"default\":\"\"},{\"name\":\"max_instances\",\"purpose\":\"The most instances to return.\",\"kind\":\"integer\",\"required\":false,\"default\":2,\"min\":1.0,\"max\":8.0},{\"name\":\"threshold\",\"purpose\":\"The detector score a box needs (the fake finds the same whatever it is).\",\"kind\":\"number\",\"required\":false,\"default\":0.2,\"min\":0.0,\"max\":1.0},{\"name\":\"pad\",\"purpose\":\"How far each found box is widened (the fake ignores it).\",\"kind\":\"number\",\"required\":false,\"default\":0.05,\"min\":0.0,\"max\":0.5},{\"name\":\"delay_ms\",\"purpose\":\"A pause before answering, for tests of timing.\",\"kind\":\"integer\",\"required\":false,\"default\":0,\"min\":0.0,\"max\":60000.0}]}}",
